  <tag k="description" v="Die Katharinenkirche ist die evangelische Hauptkirche in Frankfurt am Main. Spätgotischer Hallenbau mit Barockportalen. Er wurde 1678 bis 1681 errichtet und 1944 im Zweiten Weltkrieg zerstört. Der Wiederaufbau erfolgte 1950 bis 1954."/>
  <tag k="description:en" v="St. Catherine's Church is the main Protestant church in Frankfurt am Main. A late Gothic hall building with baroque portals. It was built between 1678 and 1681 and destroyed in 1944 during the Second World War. It was rebuilt between 1950 and 1954."/>
  <tag k="heritage" v="4"/>
  <tag k="heritage:operator" v="LfDH"/>
  <tag k="heritage:website" v="http://denkxweb.denkmalpflege-hessen.de/518894"/>
