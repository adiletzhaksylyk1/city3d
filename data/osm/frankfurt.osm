  <tag k="amenity" v="place_of_worship"/>
  <tag k="building" v="church"/>
  <tag k="building:architecture" v="gothic"/>
  <tag k="check_date" v="2024-10-12"/>
  <tag k="denomination" v="protestant"/>
  <tag k="description" v="Doppelschiffige Hallenkirche der Frühgotik um 1270-90, ab 1292 mit hochgotischem Chor, bis 1467 mit spätgotischer Dachgalerie und Turmgechossen ergänzt. Ursprünglich Ratskapelle (Ersatz einer romanischen Saalkirche)."/>
  <tag k="description:en" v="Early Gothic double-nave hall church from around 1270-90, from 1292 with high Gothic choir, completed by 1467 with late Gothic roof gallery and tower storeys. Originally a council chapel (replacement for a Romanesque hall church)."/>
  <tag k="heritage" v="4"/>
  <tag k="heritage:operator" v="LfDH"/>
  <tag k="heritage:website" v="http://denkxweb.denkmalpflege-hessen.de/518832"/>
  <tag k="name" v="Alte Nikolaikirche"/>
  <tag k="name:de" v="Alte Nikolaikirche"/>
  <tag k="name:en" v="Old St. Nicholas Church"/>
  <tag k="name:etymology" v="Heiliger Nikolaus"/>
  <tag k="name:etymology:wikidata" v="Q44269"/>
  <tag k="name:etymology:wikipedia" v="de:Nikolaus von Myra"/>
  <tag k="name:ko" v="니콜라이 교회"/>
