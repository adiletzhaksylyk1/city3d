  <tag k="artwork_type" v="sculpture"/>
  <tag k="description" v="Die geduckte Haltung des Bären symbolisiert den Abwärtstrend der Börsenkurse. Die stolze, aufgerichtete Haltung des Bullen drückt hingegen einen Aufwärtstrend aus."/>
  <tag k="description:en" v="The bear's crouched posture symbolises the downward trend in stock market prices. The proud, upright stance of the bull, on the other hand, symbolises an upward trend."/>
  <tag k="material" v="bronze"/>
  <tag k="name" v="Bulle und Bär"/>
  <tag k="start_date" v="1985"/>
  <tag k="tourism" v="artwork"/>
