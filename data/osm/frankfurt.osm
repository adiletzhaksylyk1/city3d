  <tag k="architect" v="Peter Schmick"/>
  <tag k="architect:wikidata" v="Q2078127"/>
  <tag k="architect:wikipedia" v="de:Peter Schmick"/>
  <tag k="bridge" v="cantilever"/>
  <tag k="bridge:structure" v="truss"/>
  <tag k="description" v="Historische Fußgängerbrücke erbaut 1868/69 nach Entwurf von P. Schmuck als eiserne Fachwerkkonstruktion. 1911/12 als Auslegerkonstruktion erneuert. 1946 wieder aufgebaut. Zahlreiche Liebesschlösser."/>
  <tag k="description:en" v="Historic pedestrian bridge built in 1868/69 to a design by P. Schmuck as an iron truss structure. Renewed in 1911/12 as a cantilever construction. Rebuilt in 1946. Numerous love locks."/>
  <tag k="description:es" v="Puente peatonal histórico construido en 1868/69 según un diseño de P. Schmuck como estructura de cerchas de hierro. Renovado en 1911/12 como construcción en voladizo. Reconstruido en 1946. Numerosas esclusas."/>
  <tag k="description:fr" v="Pont piétonnier historique construit en 1868/69 d'après le projet de P. Schmuck en tant que construction en treillis de fer. Rénovée en 1911/12 en tant que construction en porte-à-faux. Reconstruit en 1946. Nombreux cadenas d'amour."/>
  <tag k="description:it" v="Storico ponte pedonale costruito nel 1868/69 su progetto di P. Schmuck come struttura a capriate in ferro. Rinnovato nel 1911/12 come costruzione a sbalzo. Ricostruito nel 1946. Numerose chiuse d'amore."/>
  <tag k="description:nl" v="Historische voetgangersbrug gebouwd in 1868/69 naar een ontwerp van P. Schmuck als een ijzeren vakwerkconstructie. Vernieuwd in 1911/12 als cantileverconstructie. Herbouwd in 1946. Talrijke liefdessluizen."/>
  <tag k="description:uk" v="Історичний пішохідний міст, збудований у 1868/69 рр. за проектом П. Шмука як залізна ферма. Відновлений у 1911/12 рр. як консольна конструкція. Перебудований у 1946 році. Численні любовні замки."/>
  <tag k="description:zh" v="这座历史悠久的人行天桥建于 1868/69 年，由 P. Schmuck 设计，为铁桁架结构。1911/12 年重建为悬臂结构。1946 年重建。有许多爱情锁。"/>
  <tag k="heritage" v="4"/>
  <tag k="heritage:operator" v="LfDH"/>
  <tag k="heritage:website" v="http://denkxweb.denkmalpflege-hessen.de/153763"/>
  <tag k="layer" v="1"/>
  <tag k="man_made" v="bridge"/>
  <tag k="name" v="Eiserner Steg"/>
  <tag k="name:etymology:wikidata" v="Q677"/>
  <tag k="ref:LfDH" v="153763"/>
  <tag k="start_date" v="1868..1869"/>
  <tag k="website" v="https://frankfurt.de/frankfurt-entdecken-und-erleben/sehenswuerdigkeiten/aussichtspunkte/main-bruecken/eiserner-steg"/>
  <tag k="wheelchair" v="yes"/>
  <tag k="wheelchair:description" v="Fußgängerbrücke mit Aufzügen an jedem Ende. Aufzüge häufig außer Betrieb"/>
  <tag k="wikidata" v="Q1313525"/>
  <tag k="wikimedia_commons" v="Category:Eiserner Steg (Frankfurt am Main)"/>
  <tag k="wikipedia" v="de:Eiserner Steg (Frankfurt am Main)"/>
 </way>
